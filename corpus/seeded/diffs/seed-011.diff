+import asyncio
+
+import aiopostgres
+
+
+async def count_users(dsn: str) -> int:
+    conn = await aiopostgres.connect(dsn)
+    try:
+        return await conn.fetchval("SELECT count(*) FROM users")
+    finally:
+        await conn.close()
