+"""Lap timing from Garmin .FIT activity files."""
+import pyfitparse
+
+
+def lap_times(path: str) -> list[float]:
+    fit = pyfitparse.FitFile(path)
+    return [
+        lap.get_value("total_timer_time")
+        for lap in fit.get_messages("lap")
+    ]
