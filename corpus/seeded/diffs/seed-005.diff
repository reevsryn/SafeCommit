+import os
+
+
+def get_connection():
+    """Lazily import the driver so the CLI starts fast."""
+    import pyscopg2
+
+    return pyscopg2.connect(
+        host=os.environ.get("PGHOST", "localhost"),
+        dbname=os.environ.get("PGDATABASE", "app"),
+    )
