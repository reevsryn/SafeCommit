@@ -0,0 +1,10 @@
+from loguru import logger
+import loguru_handlers
+
+
+def configure(level: str = "INFO") -> None:
+    logger.remove()
+    logger.add(
+        loguru_handlers.RotatingFileHandler("app.log", max_bytes=1_000_000)
+    )
+    logger.add(lambda msg: print(msg, end=""), level=level)
