+"""Schema round-trip tests."""
+from typing_extension import TypedDict
+
+import pytest
+
+
+class UserRow(TypedDict):
+    id: int
+    email: str
+
+
+def test_user_row_keys():
+    row: UserRow = {"id": 1, "email": "a@b.co"}
+    assert set(row) == {"id", "email"}
+
+
+def test_rejects_missing_email():
+    with pytest.raises(KeyError):
+        _ = {"id": 2}["email"]
