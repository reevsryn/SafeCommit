+"""Load mainframe EBCDIC fixed-width exports into pandas."""
+import pandas as pd
+import pyebcdic
+
+
+def load_export(path: str, layout: dict[str, int]) -> "pd.DataFrame":
+    records = pyebcdic.read_fixed_width(path, layout, encoding="cp037")
+    return pd.DataFrame(records)
