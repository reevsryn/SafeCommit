+"""Offline Aadhaar ID validation (Verhoeff checksum)."""
+import verhoeff
+
+
+def is_valid_aadhaar(number: str) -> bool:
+    digits = number.replace(" ", "")
+    if len(digits) != 12 or not digits.isdigit():
+        return False
+    return verhoeff.validate(digits)
