+
+        session = tb.ResultSession()
+        task = Task(tid)
+        task.status = states.SUCCESS
+        task.result = b'not-json-and-not-pickle-either'
+        session.add(task)
+        session.commit()
+        session.close()
+
+        with pytest.raises(Exception):
+            tb.get_task_meta(tid)
+
