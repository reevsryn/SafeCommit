+class _CollectingStreamer:
+    """Keeps every tensor it is handed, so a stream can be compared against the sequences that were returned."""
+
+    def __init__(self):
+        self.tokens = []
+
+    def put(self, value):
+        self.tokens.append(value.reshape(-1).cpu())
+
+    def end(self):
+        pass
+
