+                st.session_state["hide"] = True
+                st.rerun()
+
+    at = AppTest.from_function(script).run()
+    at.text_input(key="hidden").input("keep?").run()
+    assert at.session_state["hidden"] == "keep?"
+
+    at.button[0].click().run()
+    assert "hidden" not in at.session_state
