+        union = columns
+        null_filled = frozenset()
+        explicit_nulls = row_nulls
+        seen = {tr["target_value"]}
+        rows = [tr]
+
+    if rows:
+        segments.append(_UpsertSegment(conflict_target, union, null_filled, rows))
+
