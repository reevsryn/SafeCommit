+              value:
+                callable: |
+                  lambda row: row.data.decode('utf-8')
+                output_type: string
+        - type: AssertEqual
+          config:
+            elements:
+              - {value: "123"}
+              - {value: "456"}
+              - {value: "789"}
+
+    options:
+      streaming: true
