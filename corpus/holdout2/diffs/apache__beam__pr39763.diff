+      Schema.builder()
+          .addByteArrayField("data")
+          .addStringField("stream_name")
+          .addStringField("partition_key")
+          .addStringField("sequence_number")
+          .addStringField("shard_id")
+          .addDateTimeField("approximate_arrival_timestamp")
