+    # LOGGER_FORMAT: "%(asctime)s\t%(levelname)s %(filename)s:%(lineno)s -- %(message)s"
+    assert re.match(
+        r"^\d{4}-\d{2}-\d{2} [\d:,]+\tINFO \S+:\d+ -- visible message$", line
