+    assert svg_filenames == [str(svg_path)]
+    assert 'fill="red"' in svg_path.read_text()
+    assert png_filename == str(png_path)
+    with PIL.Image.open(png_filename) as png:
+        assert png.size == (20, 20)
+    assert first_browser == second_browser
+
