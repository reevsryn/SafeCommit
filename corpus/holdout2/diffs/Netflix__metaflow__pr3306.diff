+
+def _write_uploader_log(message):
+    try:
+        payload = decorate(TASK_LOG_SOURCE, "%s\n" % message)
+        with open(os.environ["PERIODICAL_UPLOADER_LOG_PATH"], "ab", buffering=0) as log:
