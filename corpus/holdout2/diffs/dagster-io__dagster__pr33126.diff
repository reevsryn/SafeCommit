+        (S3CredentialsComponent, S3Resource),
+        (AthenaCredentialsComponent, ResourceWithAthenaConfig),
+        (RedshiftCredentialsComponent, RedshiftClientResource),
+        (S3ResourceComponent, S3Resource),
