+_UV_BASE_URL = "https://github.com/astral-sh/uv/releases/download"
+_UV_VERSION = "0.6.11"
+
+_UV_TARGET_MAP = {
+    ("linux", "x86_64"): "x86_64-unknown-linux-gnu",
+    ("linux", "amd64"): "x86_64-unknown-linux-gnu",
+    ("linux", "aarch64"): "aarch64-unknown-linux-gnu",
